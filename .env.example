# Copy to .env and adjust. Everything here has a working default in
# docker-compose.yml / config.py — you only need this file to override
# something (a real Dubai Pulse key, a different port, etc).

SMARTCITY_MODEL_MODE=mock
SMARTCITY_POSTGRES_URL=postgresql://smartcity:smartcity@localhost:5432/smartcity
SMARTCITY_REDIS_URL=redis://localhost:6379/0
SMARTCITY_JWT_SECRET=change-me-in-production
# Password for the seeded demo accounts. The defaults are accepted only while
# SMARTCITY_ENVIRONMENT=development; any other environment refuses to start
# until a 32+ char JWT secret and a non-default password are set.
SMARTCITY_DEMO_PASSWORD=demo
# Set true only behind your own reverse proxy (client IP for rate limiting).
SMARTCITY_TRUST_PROXY_HEADERS=false

# Mongo is NOT part of the default stack (nothing in the code path uses it
# yet — see docker-compose.yml). Only set this if you start it with
# `docker compose --profile full up -d`.
# SMARTCITY_MONGO_URL=mongodb://localhost:27017

# --- M10: OpenStreetMap / Overpass (road network + places ingestion) -------
# The default (overpass-api.de) is a shared public instance the ingest code
# already fails over away from when it's busy — you don't need to set this
# unless you're running your own Overpass mirror.
# SMARTCITY_OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- M9: CCTV cameras --------------------------------------------------------
# Camera passwords are never stored in the database — only a credential_ref
# naming an env var is stored, and that env var is set here (or per-camera,
# per the name you chose in the registry). Example:
# CAM_SZR_01=the-camera-password

# --- Dubai Pulse open data (real RTA/Dubai government traffic feeds) --------
# Optional. Without these the platform just reports the connector as "not
# configured" rather than failing. Get credentials at dubaipulse.gov.ae.
# SMARTCITY_DUBAI_PULSE_KEY=
# SMARTCITY_DUBAI_PULSE_SECRET=

# --- Frontend -----------------------------------------------------------------
# 8001, not 8000: the backend is mapped to 8001 in docker-compose.yml to avoid
# colliding with other local projects using the default port.
NEXT_PUBLIC_API_URL=http://localhost:8001
